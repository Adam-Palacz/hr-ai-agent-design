@startuml C4_L1_Context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

Person(hr, "HR user", "Uses web UI to manage candidates, decisions and feedback emails.")
Person(candidate, "Candidate", "Receives feedback emails and can reply or ask questions.")

System(system, "Recruitment AI system", "Flask-based recruitment support app.")

System_Ext(llm, "LLM provider", "OpenAI for local demo or Azure OpenAI for production.")
System_Ext(mail, "Mail server", "SMTP/IMAP provider (Zoho, Gmail, O365, etc.).")
System_Ext(qdrant, "Qdrant", "Vector database used for RAG knowledge base.")

Rel(hr, system, "Uses via browser")
Rel(candidate, mail, "Sends and receives email")

Rel(system, llm, "Parses CVs, generates/validates/corrects feedback, answers questions")
Rel(system, mail, "Sends feedback emails; polls incoming email via SMTP/IMAP")
Rel(system, qdrant, "Retrieves RAG context for answers")

SHOW_LEGEND()

@enduml
