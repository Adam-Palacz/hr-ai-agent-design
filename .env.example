AZURE_OPENAI_ENDPOINT=<from azure foundry>
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# LLM provider selection:
# azure  – default, uses Azure OpenAI (config above)
# openai – use OpenAI official API (requires OPENAI_API_KEY)
LLM_PROVIDER=azure

# For OpenAI official (used when LLM_PROVIDER=openai):
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4.1-nano

IOD_EMAIL=<iod_email>
HR_EMAIL=<hr_email>
EMAIL_MONITOR_ENABLED=true
EMAIL_CHECK_INTERVAL=60

EMAIL_USERNAME=<recruitment_email>
EMAIL_PASSWORD=<email app password>
SMTP_HOST=smtp.zoho.eu #example zoho host
SMTP_PORT=587
SMTP_USE_TLS=true
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993

PRIVACY_POLICY_URL=https://firma.pl/klauzula-informacyjna
