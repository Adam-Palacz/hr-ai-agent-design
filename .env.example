# Demo/local: use OpenAI API with LLM_PROVIDER=openai.
# Production: use Azure OpenAI with LLM_PROVIDER=azure and an EU Azure region
# for stronger control over data processing location.

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-12-01-preview
AZURE_OPENAI_GPT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_VISION_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_KEY=

# LLM + embeddings provider (chat and Qdrant/RAG use the same setting):
# openai - recommended for local/demo (one OPENAI_API_KEY for chat + embeddings)
# azure  - recommended for production (choose an EU Azure region for data residency)
LLM_PROVIDER=openai

# For OpenAI official (when LLM_PROVIDER=openai):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

IOD_EMAIL=
HR_EMAIL=
EMAIL_MONITOR_ENABLED=false
EMAIL_CHECK_INTERVAL=60

EMAIL_USERNAME=
EMAIL_PASSWORD=
SMTP_HOST=smtp.zoho.eu
SMTP_PORT=587
SMTP_USE_TLS=true
IMAP_HOST=imap.zoho.eu
IMAP_PORT=993

PRIVACY_POLICY_URL=https://firma.pl/klauzula-informacyjna

# CV processing (two levels):
# CV_PARSING_ENABLED=false     — skip everything (no PDF read, no LLM; use candidate from DB)
# CV_LLM_PARSING_ENABLED=false — read PDF text only, no LLM structured parse (requires CV_PARSING_ENABLED=true)
CV_PARSING_ENABLED=true
CV_LLM_PARSING_ENABLED=true
